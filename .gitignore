# ─── Secrets / machine-specific ───────────────────────────────
certs/                      # self-signed HTTPS key+cert (PRIVATE — never commit)
.env
*.pem

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ─── Editor / OS junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ─── Claude Code / tooling ────────────────────────────────────
.claude/

# ─── Large data ───────────────────────────────────────────────
# NOTE: reference_audio/mujawwad IS committed (the app's word-by-word audio,
# ~416 MB / 77k files) so the repo works out of the box.
# The following are kept OUT of git:
reference_audio/muallim/       # unused alternate reciter set
reference_audio/husary/        # Tajweed audio — cached automatically at runtime
Quranic-Word-By-Word-Audio-Data/   # upstream dataset clone (its own git repo)
.__serve_test.log
*.log
build/
dist/
*.spec.bak

# ONNX export (on-device model work)
muaalem.onnx
muaalem.onnx.data
*.onnx
*.onnx.data

# ─── Android app (mobile/) ────────────────────────────────────────────────
# SECRETS — the upload key and its passwords. Never commit these.
mobile/android/al-muqri-release.jks
mobile/android/key.properties
*.jks
*.keystore

# Build output and dependencies (all reproducible)
mobile/node_modules/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/release/
*.aab
*.apks
*.apk

# Play Asset Delivery payloads. Too large for git (837 MB model, 381 MB audio);
# regenerate with the scripts in tools/ — see README.
mobile/android/model_pack/src/main/assets/
mobile/android/audio_pack/src/main/assets/
mobile/www/model/
mobile/www/audio/wbw/

# Generated by `npx cap sync` — a verbatim copy of mobile/www/. Committing it
# duplicates ~14 MB and lets the two drift apart. www/ is the source of truth.
mobile/android/app/src/main/assets/public/

# Stale handoff bundle
al-muqri-mobile-handoff.zip
